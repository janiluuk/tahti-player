{
  "name": "Tahti Player",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "tahti-web",
      "command": "VITE_FORCE_MOCK=1 pnpm dev:tahti"
    },
    {
      "name": "storybook",
      "command": "pnpm storybook"
    }
  ],
  "ports": [
    { "name": "tahti-web", "port": 5180 },
    { "name": "storybook", "port": 6006 }
  ]
}
