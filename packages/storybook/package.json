{
  "name": "@tahti-player/storybook",
  "version": "0.0.10",
  "description": "Storybook for Tahti Player and tahti-web UI components",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build",
    "preview": "storybook preview",
    "type-check": "tsc -p tsconfig.tahti.json --noEmit",
    "test": "vitest run --project storybook",
    "clean": "rm -rf storybook-static .turbo node_modules/.cache",
    "deploy:vimage": "./deploy/deploy-vimage.sh"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/space-mono": "^5.2.9",
    "@tahti-player/model": "workspace:*",
    "@tahti-player/tailwind-config": "workspace:*",
    "@tahti-player/themes": "workspace:*",
    "@tahti-player/ui": "workspace:*",
    "@tanstack/react-router": "^1.131.2",
    "hls.js": "^1.5.15",
    "lucide-react": "^0.542.0",
    "mermaid": "^11.16.1",
    "motion": "^12.23.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "storybook": "^10.0.0",
    "three": "^0.184.0",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/addon-links": "^10.0.0",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.0.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^18.3.23",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.0.1",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint-plugin-storybook": "10.4.6",
    "playwright": "^1.55.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.1.11"
  }
}
