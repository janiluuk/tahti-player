{
  "name": "@tahti-player/player",
  "version": "1.47.205",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tsc -p tsconfig.tahti.json && vite build && tauri build --no-bundle",
    "build:frontend": "tsc -p tsconfig.tahti.json && vite build",
    "tauri": "tauri",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "type-check": "tsc -p tsconfig.tahti.json --noEmit",
    "clean": "rm -rf dist build .turbo node_modules/.vite"
  },
  "dependencies": {
    "@tahti-player/eslint-config": "workspace:*",
    "@tahti-player/i18n": "workspace:*",
    "@tahti-player/model": "workspace:*",
    "@tahti-player/tailwind-config": "workspace:*",
    "@tahti-player/themes": "workspace:*",
    "@tahti-player/ui": "workspace:*",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "~2.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "^2.0.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2.8.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.1",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.0.0"
  }
}
