{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tahti Player",
  "mainBinaryName": "tahti-player",
  "version": "1.47.56",
  "identifier": "live.tahti.player",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "cd ../.. && pnpm --filter @tahti-player/player build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Tahti Player",
        "width": 1280,
        "height": 720,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "shortDescription": "Independent artist broadcasting and music player",
    "longDescription": "Tahti Player is a free, open-source broadcasting and music player for independent artists, with live channels, archives, and fan-supported listening.",
    "copyright": "Copyright 2025-2026 Tahti ry",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZENThDRjNFODg5MUNGRjUKUldUMXo1R0lQczlZYlVjWENnTnZTNW1OQUl5Nzl3dzFRdjlWNGZBVkF2SVhWcHRVbDY3ZHhqSVgK",
      "endpoints": [
        "https://github.com/janiluuk/tahti-player/releases/latest/download/latest.json"
      ]
    }
  }
}
