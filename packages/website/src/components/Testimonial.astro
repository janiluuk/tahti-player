---
import type { Testimonial } from '../data/testimonials';

type Props = Testimonial;

const { quote, author, source, url } = Astro.props;
const Element = url ? 'a' : 'div';
---

<Element
  href={url}
  class="themed-border border-border bg-background-secondary shadow-shadow prefers-dark:hover:brightness-125 flex w-80 shrink-0 flex-col gap-3 rounded-md p-5 text-left transition duration-200 hover:brightness-95"
>
  <span class="text-base font-bold">
    {author}{source ? `, ${source}` : ''}
  </span>
  <p class="text-sm whitespace-pre-line">{quote}</p>
</Element>
