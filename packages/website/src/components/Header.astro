---
import { Icon } from 'astro-icon/components';

import { stars } from '../data/github';
import Button from './Button.astro';
---

<header
  class="border-border flex h-16 items-center justify-between border-b px-4 md:px-8"
>
  <a href="/">
    <img
      src="/images/logo-full-outlined.svg"
      alt="Nuclear"
      class="dark-mode-hidden h-8"
    />
    <img
      src="/images/logo-full-light-outlined.svg"
      alt="Nuclear"
      class="dark-mode-block hidden h-8"
    />
  </a>

  <nav></nav>

  <div class="flex items-center gap-3">
    <Button
      href="https://discord.gg/JqPjKxE"
      variant="discord"
      size="sm"
      class="prefers-dark:text-foreground prefers-dark:bg-background prefers-dark:border-(--color-discord) gap-2 bg-(--color-discord) font-bold text-white"
    >
      <Icon name="simple-icons:discord" class="h-5 w-5" />
      <span class="hidden md:inline">Join our Discord</span>
    </Button>
    <Button
      href="https://github.com/janiluuk/tahti-player"
      variant="secondary"
      size="sm"
      class="gap-2 font-bold"
    >
      <Icon name="simple-icons:github" class="h-5 w-5" />
      <span class="hidden md:inline"
        >{stars ? `${stars} stars` : 'Star on GitHub'}</span
      >
    </Button>
  </div>
</header>
