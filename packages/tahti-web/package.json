{
  "name": "@tahti-player/tahti-web",
  "version": "0.0.70",
  "private": true,
  "type": "module",
  "description": "POC: Tahti listen experience on Nuclear UI — eventual production web listen client",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude 'e2e/**'",
    "test:e2e": "playwright test",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "check:api-docs": "node scripts/check-api-docs.mjs",
    "lint": "eslint . --ignore-pattern test-results --ignore-pattern playwright-report",
    "clean": "rm -rf dist .turbo node_modules/.vite",
    "deploy:vimage": "./deploy/deploy-vimage.sh"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@tahti-player/i18n": "workspace:*",
    "@tahti-player/model": "workspace:*",
    "@tahti-player/tailwind-config": "workspace:*",
    "@tahti-player/themes": "workspace:*",
    "@tahti-player/ui": "workspace:*",
    "@tanstack/react-router": "^1.131.2",
    "hls.js": "^1.5.15",
    "lucide-react": "^0.542.0",
    "mermaid": "^11.16.1",
    "motion": "^12.23.12",
    "qrcode.react": "4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "three": "^0.184.0",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tahti-player/eslint-config": "workspace:*",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.0.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.0.0"
  }
}
