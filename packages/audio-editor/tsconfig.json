{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "jsx": "react-jsx",
    "types": ["vitest/globals"],
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@tahti-player/ui": ["../ui/dist/index.d.ts"],
      "@tahti-player/audio-core": ["../audio-core/src/index.ts"],
      "@tahti-player/audio-rack": ["../audio-rack/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
