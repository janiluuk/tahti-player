{
  "name": "tahti-player",
  "version": "0.0.10",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev --filter=@tahti-player/player --filter=@tahti-player/ui",
    "dev:remote": "VITE_HOST=0.0.0.0 turbo dev --filter=@tahti-player/player --filter=@tahti-player/ui",
    "dev:tahti": "pnpm --filter @tahti-player/tahti-web dev",
    "deploy:tahti-beta": "pnpm --filter @tahti-player/tahti-web run deploy:vimage",
    "deploy:tahti-storybook": "pnpm --filter @tahti-player/storybook run deploy:vimage",
    "build": "turbo build",
    "build:linux:run": "./scripts/build-and-run-linux.sh",
    "player:build:run": "./scripts/build-and-run-player.sh",
    "player:run": "./scripts/run-linux.sh",
    "build:android:run": "./scripts/build-and-run-android.sh",
    "lint": "turbo lint",
    "check:file-size": "node scripts/check-file-size.mjs",
    "lint:fix": "turbo lint:fix",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage --continue",
    "snapshot-digest": "node scripts/ci/build-snapshot-digest.mjs",
    "tauri": "pnpm --filter player tauri",
    "release:prepare": "node packages/tools/src/prepare-release.mjs",
    "storybook": "pnpm --filter @tahti-player/storybook dev",
    "prepare": "husky",
    "clean": "turbo clean && rm -rf node_modules/.cache",
    "type-check": "turbo type-check"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.4.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "author": {
    "name": "Tahti <noreply@tahti.live>"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "format": "^0.2.2",
    "prettier": "^3.9.8",
    "prettierr": "1.15.3-dev"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-react>eslint": "10",
        "@codecov/vite-plugin>vite": "7"
      }
    }
  }
}
